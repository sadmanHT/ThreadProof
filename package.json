{
  "name": "threadproof",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "contracts:compile": "pnpm --filter @threadproof/contracts compile",
    "contracts:test": "pnpm --filter @threadproof/contracts test",
    "circuits:compile": "pnpm --filter @threadproof/circuits compile",
    "circuits:test": "pnpm --filter @threadproof/circuits test",
    "endgame:scorecard": "node scripts/endgame-scorecard.mjs",
    "recovery:verify": "node scripts/production-recovery-verify.mjs",
    "recovery:test": "node scripts/test-production-recovery-evidence.mjs && node scripts/test-production-recovery-source-binding.mjs",
    "evidence:test:capture": "node scripts/test-production-evidence-capture.mjs && pnpm --filter @threadproof/contracts test:production-evidence-capture",
    "evidence:capture:production": "pnpm --filter @threadproof/contracts capture:production-evidence --",
    "infra:validate:consortium": "node scripts/validate-threadproof-production-topology.mjs",
    "infra:test:qbft-startup": "node scripts/test-qbft-startup-policy.mjs",
    "competition:preflight": "node scripts/competition-deployment-preflight.mjs",
    "competition:test": "node scripts/test-competition-deployment-preflight.mjs",
    "pilot:prepare": "node scripts/pilot-chain.mjs prepare",
    "pilot:up": "node scripts/pilot-chain.mjs up",
    "pilot:verify": "node scripts/pilot-chain.mjs verify",
    "pilot:fault-resilience": "node scripts/pilot-fault-resilience.mjs",
    "pilot:down": "node scripts/pilot-chain.mjs down",
    "pilot:reset": "node scripts/pilot-chain.mjs reset",
    "reset:e2e-users": "node apps/web/scripts/reset-e2e-demo-users.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
