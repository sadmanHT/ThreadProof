{
  "name": "threadproof",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "contracts:compile": "pnpm --filter @threadproof/contracts compile",
    "contracts:test": "pnpm --filter @threadproof/contracts test",
    "circuits:compile": "pnpm --filter @threadproof/circuits compile",
    "circuits:test": "pnpm --filter @threadproof/circuits test",
    "endgame:scorecard": "node scripts/endgame-scorecard.mjs",
    "infra:validate:consortium": "node scripts/validate-threadproof-production-topology.mjs",
    "infra:test:qbft-startup": "node scripts/test-qbft-startup-policy.mjs",
    "pilot:prepare": "node scripts/pilot-chain.mjs prepare",
    "pilot:up": "node scripts/pilot-chain.mjs up",
    "pilot:verify": "node scripts/pilot-chain.mjs verify",
    "pilot:fault-resilience": "node scripts/pilot-fault-resilience.mjs",
    "pilot:down": "node scripts/pilot-chain.mjs down",
    "pilot:reset": "node scripts/pilot-chain.mjs reset"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
