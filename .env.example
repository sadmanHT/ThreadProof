# Web / Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Worker/server-only. Never expose this key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Blockchain RPC
THREADPROOF_CHAIN_ID=2026
THREADPROOF_RPC_URL=http://127.0.0.1:8545
THREADPROOF_WS_URL=ws://127.0.0.1:8546
THREADPROOF_CONFIRMATIONS=1

# Deployed contract addresses used by existing deployment tooling
THREADPROOF_REGISTRY_ADDRESS=
CREDENTIAL_REGISTRY_ADDRESS=
ORDER_REGISTRY_ADDRESS=
CAPACITY_VAULT_ADDRESS=
SUBCONTRACT_GOVERNOR_ADDRESS=
THREADPROOF_CHARTER_ADDRESS=
CAPACITY_SPEND_VERIFIER_ADDRESS=

# Worker aliases for explicit protocol-service configuration
THREADPROOF_CREDENTIAL_REGISTRY_ADDRESS=
THREADPROOF_ORDER_REGISTRY_ADDRESS=
THREADPROOF_CAPACITY_VAULT_ADDRESS=
THREADPROOF_INDEXER_START_BLOCK=0
THREADPROOF_INDEXER_BLOCK_BATCH=1000

# Transaction signing - local development only. Production must use KMS/HSM or external signers.
DEV_DEPLOYER_PRIVATE_KEY=
DEV_BUYER_PRIVATE_KEY=
DEV_FACTORY_PRIVATE_KEY=
DEV_AUDITOR_PRIVATE_KEY=
DEV_REGULATOR_PRIVATE_KEY=
# Optional service relayer. Do not use a raw private key for production deployments.
THREADPROOF_RELAYER_PRIVATE_KEY=

# ZK artifacts
CAPACITY_SPEND_WASM_PATH=packages/circuits/artifacts/CapacitySpend_js/CapacitySpend.wasm
CAPACITY_SPEND_ZKEY_PATH=packages/circuits/artifacts/CapacitySpend_final.zkey
CAPACITY_SPEND_VKEY_PATH=packages/circuits/artifacts/verification_key.json
THREADPROOF_CAPACITY_WASM_PATH=packages/circuits/artifacts/CapacitySpend_js/CapacitySpend.wasm
THREADPROOF_CAPACITY_ZKEY_PATH=packages/circuits/artifacts/CapacitySpend_final.zkey
THREADPROOF_CAPACITY_VKEY_PATH=packages/circuits/artifacts/verification_key.json

# Encryption / key management
# Base64-encoded 32-byte AES-256 key for worker-side private witness envelopes.
THREADPROOF_DATA_KEY_BASE64=
# JSON object mapping canonical 0x... factory organization IDs to decimal field secrets.
# Production should resolve these secrets from KMS/HSM rather than a flat environment value.
THREADPROOF_FACTORY_SECRETS_JSON={}
PRIVATE_DATA_ENCRYPTION_KEY=
IDENTITY_ENCRYPTION_KEY=

# Worker execution
THREADPROOF_RUN_ONCE=false

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
