# Web / Supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ThreadProof Intelligence / Gemini
# Server-side only. Never prefix GEMINI_API_KEY with NEXT_PUBLIC_.
GEMINI_API_KEY=
THREADPROOF_AI_MODEL=gemini-3.7-flash
THREADPROOF_AI_PROVIDER_TIER=free
THREADPROOF_AI_MAX_RUNS_PER_MINUTE=5
# Keep false for Gemini free-tier deployments. Synthetic competition documents can be
# analyzed through the explicit UI confirmation without changing this setting.
# Set true only together with a non-free provider tier/configuration approved for real
# counterparty-confidential commercial data.
THREADPROOF_AI_ALLOW_CONFIDENTIAL=false

# Blockchain RPC
THREADPROOF_CHAIN_ID=2026
NEXT_PUBLIC_THREADPROOF_CHAIN_ID=2026
THREADPROOF_RPC_URL=http://127.0.0.1:8545
THREADPROOF_WS_URL=ws://127.0.0.1:8546
THREADPROOF_CONFIRMATIONS=1

# Deployed contract addresses
# THREADPROOF_* names are consumed by the application/worker services.
THREADPROOF_REGISTRY_ADDRESS=
THREADPROOF_CREDENTIAL_REGISTRY_ADDRESS=
THREADPROOF_ORDER_REGISTRY_ADDRESS=
THREADPROOF_CAPACITY_VAULT_ADDRESS=
THREADPROOF_SUBCONTRACT_GOVERNOR_ADDRESS=
THREADPROOF_CHARTER_ADDRESS=
THREADPROOF_CAPACITY_SPEND_VERIFIER_ADDRESS=

# Legacy contract-tooling aliases retained while deployment scripts are migrated.
CREDENTIAL_REGISTRY_ADDRESS=
ORDER_REGISTRY_ADDRESS=
CAPACITY_VAULT_ADDRESS=
SUBCONTRACT_GOVERNOR_ADDRESS=
THREADPROOF_CHARTER_ADDRESS=
CAPACITY_SPEND_VERIFIER_ADDRESS=

# Transaction signing - local development only.
# Production relayer/organization keys must come from KMS/HSM or an external signer.
THREADPROOF_RELAYER_PRIVATE_KEY=
DEV_DEPLOYER_PRIVATE_KEY=
DEV_BUYER_PRIVATE_KEY=
DEV_FACTORY_PRIVATE_KEY=
DEV_AUDITOR_PRIVATE_KEY=
DEV_REGULATOR_PRIVATE_KEY=

# ZK artifacts
THREADPROOF_CAPACITY_WASM_PATH=packages/circuits/artifacts/CapacitySpend_js/CapacitySpend.wasm
THREADPROOF_CAPACITY_ZKEY_PATH=packages/circuits/artifacts/CapacitySpend_final.zkey
THREADPROOF_CAPACITY_VKEY_PATH=packages/circuits/artifacts/verification_key.json
CAPACITY_SPEND_WASM_PATH=packages/circuits/artifacts/CapacitySpend_js/CapacitySpend.wasm
CAPACITY_SPEND_ZKEY_PATH=packages/circuits/artifacts/CapacitySpend_final.zkey
CAPACITY_SPEND_VKEY_PATH=packages/circuits/artifacts/verification_key.json

# Private witness/order encryption and factory nullifier secrets.
# THREADPROOF_DATA_KEY_BASE64 must decode to exactly 32 bytes. Do not commit real values.
THREADPROOF_DATA_KEY_BASE64=
THREADPROOF_FACTORY_SECRETS_JSON={}
PRIVATE_DATA_ENCRYPTION_KEY=
IDENTITY_ENCRYPTION_KEY=

# Indexer
THREADPROOF_INDEXER_START_BLOCK=0
THREADPROOF_INDEXER_BLOCK_BATCH=1000

# Observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
