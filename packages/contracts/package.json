{
  "name": "@threadproof/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "typecheck": "hardhat compile && tsc --noEmit",
    "deploy:local": "hardhat run scripts/deploy-local.ts",
    "verify:generated": "hardhat run scripts/generated-verifier-smoke.ts",
    "verify:live-pofc": "hardhat run scripts/live-pofc.ts",
    "verify:live-subcontract": "hardhat run scripts/live-subcontract.ts",
    "verify:live-capacity-release": "hardhat run scripts/live-capacity-release.ts",
    "verify:production-deployment": "hardhat run scripts/verify-production-deployment.ts --network threadproofLocal",
    "test:production-verifier-wrapper": "node scripts/test-production-verifier-wrapper.mjs",
    "generate:production-verifier-wrapper": "node scripts/generate-production-verifier-wrapper.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
